# API Keys for Data Ingestion
# Required for CrowdWisdomTrading reproduction

# Apify API Token (https://console.apify.com/account#/integrations)
APIFY_API_TOKEN=your_apify_token_here

# Exa.com API Key (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=your_exa_api_key_here

# Optional: Tavily API Key if fallback search is needed
TAVILY_API_KEY=your_tavily_key_here

# Apify Actor IDs used in the scraping pipeline
APIFY_TELEGRAM_ACTOR_ID=lofomachines/telegram-keyword-search-scraper
APIFY_WEB_SCRAPER_ACTOR_ID=apify/web-scraper
APIFY_LIHKG_ACTOR_ID=apify/cheerio-scraper
APIFY_NAVER_ACTOR_ID=apify/cheerio-scraper
